{
  "regions": [
    "cdg1"
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/img/:f",
      "destination": "https://erzalqrqeigprnbslfka.supabase.co/storage/v1/object/public/web/img/:f"
    },
    {
      "source": "/fonts/:f",
      "destination": "https://erzalqrqeigprnbslfka.supabase.co/storage/v1/object/public/web/fonts/:f"
    },
    {
      "source": "/app.js",
      "destination": "https://erzalqrqeigprnbslfka.supabase.co/storage/v1/object/public/web/static/app.js"
    },
    {
      "source": "/estilos.css",
      "destination": "https://erzalqrqeigprnbslfka.supabase.co/storage/v1/object/public/web/static/estilos.css"
    }
  ]
}